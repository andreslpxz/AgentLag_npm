TAVILY_API_KEY=""

# ─── Azure OpenAI (provider: "azure") ────────────────────────────────────────
# Get these from https://portal.azure.com → your Azure OpenAI resource.
# The "model" you select in AgentLag is actually the deployment name.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_INSTANCE_NAME=""        # e.g. "my-resource" from https://my-resource.openai.azure.com
AZURE_OPENAI_API_DEPLOYMENT_NAME=""      # e.g. "gpt-4o-deployment"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# ─── Google Vertex AI (provider: "vertexai") ─────────────────────────────────
# Auth: uses Google Cloud Application Default Credentials.
# Run `gcloud auth application-default login` first, OR set
# GOOGLE_APPLICATION_CREDENTIALS to a service account JSON file path.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# ─── Amazon Bedrock (provider: "bedrock") ────────────────────────────────────
# Auth: uses the AWS SDK default credential chain (env vars, ~/.aws/credentials,
# IAM role). Set these only if you want to override the chain.
AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""

# ─── Telegram bot (optional — used by /bot) ──────────────────────────────────
# Get them from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USER_ID=""

# ─── Discord bot (optional — used by /discord) ───────────────────────────────
# Get the token from https://discord.com/developers/applications
# Enable the "Message Content Intent" privilege in the Developer Portal
# (Bot tab → Privileged Gateway Intents) or the bot won't see message text.
DISCORD_BOT_TOKEN=""
# Optional comma-separated whitelist of Discord user IDs allowed to talk to the bot.
# If unset, ANYONE who can DM or @mention the bot can use it — set this in production.
DISCORD_ALLOWED_USER_IDS=""
# Optional comma-separated whitelist of server (guild) IDs. If unset, the bot
# responds in every server it's a member of.
DISCORD_ALLOWED_GUILD_IDS=""
# Optional command prefix (e.g. "!"). If set, the bot also responds to messages
# starting with this prefix in addition to @mentions and DMs.
DISCORD_PREFIX=""
